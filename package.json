{
  "name": "eternal-overlord-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:init": "npm run build && npx cap add android && node scripts/configure-android.mjs && npx cap sync android",
    "android:sync": "npm run build && npx cap sync android && node scripts/configure-android.mjs",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
    "android:configure": "node scripts/configure-android.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}
